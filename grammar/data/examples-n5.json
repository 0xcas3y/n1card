[{"id":1,"t":"〜は","e":"これは本です。","z":"这是书。"},{"id":2,"t":"〜が","e":"雨が降っています。","z":"正在下雨。"},{"id":3,"t":"〜を","e":"水を飲みます。","z":"喝水。"},{"id":4,"t":"〜に","e":"7時に起きます。","z":"7点起床。"},{"id":5,"t":"〜で","e":"図書館で勉強します。","z":"在图书馆学习。"},{"id":6,"t":"〜へ","e":"学校へ行きます。","z":"去学校。"},{"id":7,"t":"〜と","e":"友だちと映画を見ます。","z":"和朋友看电影。"},{"id":8,"t":"〜や","e":"机の上に本やノートがあります。","z":"桌子上有书和笔记本等。"},{"id":9,"t":"〜ね / 〜よ","e":"今日はいい天気ですね。","z":"今天天气真好呢。"},{"id":10,"t":"〜です","e":"これはペンです。","z":"这是钢笔。"},{"id":11,"t":"〜ます","e":"毎朝コーヒーを飲みます。","z":"每天早上喝咖啡。"},{"id":12,"t":"〜ません","e":"お酒を飲みません。","z":"不喝酒。"},{"id":13,"t":"〜でした","e":"昨日は雨でした。","z":"昨天下雨了。"},{"id":14,"t":"〜ました","e":"昨日、映画を見ました。","z":"昨天看了电影。"},{"id":15,"t":"〜ませんでした","e":"昨日、学校に行きませんでした。","z":"昨天没去学校。"},{"id":16,"t":"〜ではありません","e":"これは私のかばんではありません。","z":"这不是我的包。"},{"id":17,"t":"〜てください","e":"ここに名前を書いてください。","z":"请在这里写上名字。"},{"id":18,"t":"〜ている","e":"今、音楽を聴いています。","z":"现在正在听音乐。"},{"id":19,"t":"〜たい","e":"日本に行きたいです。","z":"想去日本。"},{"id":20,"t":"〜に行く / 来る","e":"食べに行きましょう。","z":"去吃吧。"},{"id":21,"t":"〜てもいいですか","e":"ここに座ってもいいですか。","z":"可以坐在这里吗？"},{"id":22,"t":"〜てはいけません","e":"ここでたばこを吸ってはいけません。","z":"这里不可以抽烟。"},{"id":23,"t":"〜なければなりません","e":"毎日薬を飲まなければなりません。","z":"必须每天吃药。"},{"id":24,"t":"〜ことができます","e":"日本語を話すことができます。","z":"能说日语。"},{"id":25,"t":"い形容詞","e":"このケーキはおいしいです。","z":"这个蛋糕很好吃。"},{"id":26,"t":"な形容詞","e":"彼女はきれいです。","z":"她很漂亮。"},{"id":27,"t":"〜くて / で","e":"この映画は長くて、おもしろいです。","z":"这部电影很长，而且很有趣。"},{"id":28,"t":"〜より〜の方が","e":"電車よりバスの方が便利です。","z":"比起电车，公共汽车更方便。"},{"id":29,"t":"〜の中で一番","e":"クラスの中で英語が一番得意です。","z":"在班里英语最拿手。"},{"id":30,"t":"〜から（理由）","e":"眠いから、早く寝ます。","z":"因为困了，早点睡。"},{"id":31,"t":"〜が / けど（逆接）","e":"日本語は難しいですが、楽しいです。","z":"日语虽然难，但很有趣。"},{"id":32,"t":"〜て（継起・因果）","e":"シャワーを浴びて、寝ました。","z":"洗了澡，然后睡觉了。"},{"id":33,"t":"〜ので","e":"具合が悪いので、学校を休みます。","z":"因为身体不舒服，请假不上学了。"},{"id":34,"t":"〜と（条件）","e":"春になると、桜が咲きます。","z":"一到春天，樱花就开了。"},{"id":35,"t":"〜がある / いる","e":"机の上に本があります。","z":"桌子上有书。"}]